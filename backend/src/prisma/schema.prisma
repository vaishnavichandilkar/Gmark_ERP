model Hsn {
  id              Int          @id @default(autoincrement())
  hsnCode         String       @unique
  type            String
  description     String?
  effectiveDate   String?
  rate            Decimal?
  active          Boolean      @default(true)
  chapterName     String?
  chapterNumber   String?
  slug            String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  taxDetails      TaxDetail[]

  @@index([hsnCode])
  @@map("hsn")
}

model TaxDetail {
  id            Int      @id @default(autoincrement())
  rateOfTax     String?
  effectiveDate String?
  description   String?
  hsnId         Int
  hsn           Hsn      @relation(fields: [hsnId], references: [id], onDelete: Cascade)

  @@map("tax_details")
}

model Transaction {
  id              Int             @id @default(autoincrement())
  accountId       Int
  bookingDate     DateTime
  invoiceNumber   String?
  transactionType TransactionType
  amount          Decimal
  entryType       BalanceType
  userId          Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  account         AccountMaster   @relation(fields: [accountId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@index([accountId])
  @@index([userId, accountId, bookingDate])
  @@map("transactions")
}

enum AccountType {
  Creditor
  Debtor
  Bank
  Cash
  CUSTOMER
  SUPPLIER
  BANK
  CASH
}

