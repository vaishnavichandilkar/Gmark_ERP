model ReceiptVoucher {
  id               Int                  @id @default(autoincrement())
  voucherNumber    String               @unique
  voucherDate      DateTime
  bankCashLedgerId Int
  paymentMode      PaymentMode
  narration        String?
  totalAmount      Decimal
  createdBy        Int
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [createdBy], references: [id])
  bankCashLedger   AccountMaster        @relation("BankCashReceipt", fields: [bankCashLedgerId], references: [id])
  items            ReceiptVoucherItem[]

  @@index([createdBy])
  @@index([bankCashLedgerId])
  @@map("receipt_vouchers")
}

model ReceiptVoucherItem {
  id             Int            @id @default(autoincrement())
  voucherId      Int
  accountId      Int
  amount         Decimal
  receiptVoucher ReceiptVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account        AccountMaster  @relation("AccountReceipt", fields: [accountId], references: [id])

  @@index([voucherId])
  @@index([accountId])
  @@map("receipt_voucher_items")
}

model PaymentVoucher {
