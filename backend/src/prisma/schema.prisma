generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                 @id @default(autoincrement())
  first_name           String?
  last_name            String?
  email                String?             @unique
  phone                String?             @unique
  username             String?             @unique
  selected_language    String?
  role                 Role                @default(buyer)
  refresh_token        String?
  onboarded_at         DateTime?
  verified             Boolean             @default(false)
  isApproved           Boolean             @default(false)
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  deleted_at           DateTime?
  isBlocked            Boolean             @default(false)
  approvalStatus       ApprovalStatus      @default(PENDING)
  rejectionReason      String?
  regType              RegType?
  isFirstApprovalLogin Boolean             @default(true)
  bankDetail           BankDetail?
  sellerDocuments      SellerDocument[]    @relation("UploadedByUser")
  shopDetail           ShopDetail?
  accounts             AccountMaster[]
  categories           Category[]
  grns                 Grn[]
  groups               Group[]
  products             Product[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseOrders       PurchaseOrder[]
  salesChallans        SalesChallan[]
  salesInvoices        SalesInvoice[]
  salesOrders          SalesOrder[]
  subGroups            SubGroup[]
  subSubGroups         SubSubGroup[]
  subSubSubGroups      SubSubSubGroup[]
  subSubSubSubGroups   SubSubSubSubGroup[]
  units                UnitMaster[]
  transactions         Transaction[]
  receiptVouchers      ReceiptVoucher[]
  paymentVouchers      PaymentVoucher[]
  journalVouchers      JournalVoucher[]
  contraVouchers       ContraVoucher[]

  @@map("User")
}

model UserProfile {
  id            Int      @id @default(autoincrement())
  phone_number  String   @unique
  name          String?
  email         String?
  profile_image String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("user_profiles")
}

model ShopDetail {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  shopName  String
  address   String
  village   String?
  pinCode   String
  state     String
  district  String
  country   String?  @default("India")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ShopDetail")
}

model BankDetail {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  holderName String
  accountNo  String   @unique
  ifsc       String
  bankName   String
  panNumber  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("BankDetail")
}

model Otp {
  id          Int      @id @default(autoincrement())
  phone       String   @unique
  otp         String
  expiresAt   DateTime
  isVerified  Boolean  @default(false)
  resendCount Int      @default(0)
  lastSentAt  DateTime @default(now())

  @@map("Otp")
}

model SellerDocument {
  id               Int                @id @default(autoincrement())
  profileId        Int?
  type             SellerDocumentType
  url              String
  category         String?
  uploadedByUserId Int?
  name             String?
  size             BigInt             @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sellerProfile    SellerProfile?     @relation(fields: [profileId], references: [id])
  uploadedByUser   User?              @relation("UploadedByUser", fields: [uploadedByUserId], references: [id])

  @@map("SellerDocument")
}

model Session {
  id               Int      @id @default(autoincrement())
  userId           Int
  userType         String
  jti              String   @unique
  refreshTokenHash String
  expiresAt        DateTime
  isRevoked        Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  resource  String
  ip        String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model SellerProfile {
  id              Int                @id @default(autoincrement())
  userId          Int                @unique
  currentStep     Int                @default(0)
  status          String             @default("IN_PROGRESS")
  sessionId       Int                @unique @default(autoincrement())
  addressId       Int?
  sellerId        Int?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt
  approvedAt      DateTime?
  onHoldUntil     DateTime?
  rejectionReason String?
  documents       SellerDocument[]
  reviews         SellerStepReview[]

  @@map("SellerProfile")
}

model SellerStepReview {
  id              Int           @id @default(autoincrement())
  sellerProfileId Int
  step            Int
  status          String        @default("PENDING")
  data            Json?
  remark          String?
  reviewedBy      String?
  reviewedAt      DateTime?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@unique([sellerProfileId, step])
  @@map("SellerStepReview")
}

model Pincode {
  id             Int      @id @default(autoincrement())
  pincode        String   @unique
  state          String
  district       String
  subDistrict    String?
  country        String?
  areas          String[]
  officeVillages Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("Pincode")
}

model Language {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Language")
}

model AccountMaster {
  id                     Int           @id @default(autoincrement())
  accountName            String
  groupName              String[]
  gstNo                  String?
  panNo                  String
  addressLine1           String
  addressLine2           String?
  pincode                String
  area                   String?
  subDistrict            String?
  district               String?
  state                  String
  country                String?
  prefix                 ContactPrefix
  contactPersonName      String
  emailId                String?
  mobileNo               String
  supplierCode           String?
  supplierCreditDays     Int?
  supplierOpeningBalance Decimal?
  supplierBalanceType    BalanceType?
  customerCode           String?
  customerCreditDays     Int?
  customerOpeningBalance Decimal?
  customerBalanceType    BalanceType?
  customerType           CustomerType?
  msmeEnabled            Boolean       @default(false)
  msmeId                 String?
  regUnder               RegUnder?
  regType                RegType?
  msmeCertificateUrl     String?
  otherDocuments         Json?
  accountType            AccountType?
  userId                 Int
  status                 MasterStatus  @default(ACTIVE)
  customerStatus         MasterStatus  @default(ACTIVE)
  supplierStatus         MasterStatus  @default(ACTIVE)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  user                   User          @relation(fields: [userId], references: [id])
  transactions           Transaction[]
  bankCashReceipts       ReceiptVoucher[]     @relation("BankCashReceipt")
  accountReceipts        ReceiptVoucherItem[] @relation("AccountReceipt")
  bankCashPayments       PaymentVoucher[]     @relation("BankCashPayment")
  accountPayments        PaymentVoucherItem[] @relation("AccountPayment")
  bankCashJournals       JournalVoucher[]     @relation("BankCashJournal")
  accountJournals        JournalVoucherItem[] @relation("AccountJournal")
  bankCashContraGivers   ContraVoucher[]     @relation("BankCashContraGiver")
  bankCashContraReceivers ContraVoucherItem[] @relation("BankCashContraReceiver")

  @@unique([accountName, userId])
  @@unique([customerCode, userId])
  @@unique([supplierCode, userId])
  @@map("account_master")
}

model SystemUomLibrary {
  id                       Int      @id @default(autoincrement())
  full_name_of_measurement String
  unit_name                String
  uom_code                 String
  created_at               DateTime @default(now())

  @@map("system_uom_library")
}

model UnitMaster {
  id                       Int        @id @default(autoincrement())
  user_id                  Int
  unit_name                String
  gst_uom                  String
  full_name_of_measurement String
  source                   UnitSource @default(SYSTEM)
  status                   UnitStatus @default(ACTIVE)
  created_at               DateTime   @default(now())
  updated_at               DateTime   @updatedAt
  products                 Product[]
  user                     User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, gst_uom])
  @@map("unit_master")
}

model Group {
  id              Int          @id @default(autoincrement())
  group_name      String
  parent_id       Int?
  userId          Int?
  is_header       Boolean      @default(false)
  status          MasterStatus @default(ACTIVE)
  opening_balance Decimal?
  balance_type    BalanceType?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  parent          Group?       @relation("GroupToGroup", fields: [parent_id], references: [id])
  children        Group[]      @relation("GroupToGroup")
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sub_groups      SubGroup[]

  @@index([userId])
  @@map("groups")
}

model SubGroup {
  id              Int           @id @default(autoincrement())
  group_id        Int
  subgroup_name   String
  userId          Int?
  status          MasterStatus  @default(ACTIVE)
  opening_balance Decimal?
  balance_type    BalanceType?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  group           Group         @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sub_sub_groups  SubSubGroup[]

  @@index([userId, group_id])
  @@map("sub_groups")
}

model SubSubGroup {
  id                 Int              @id @default(autoincrement())
  sub_group_id       Int
  name               String
  userId             Int?
  status             MasterStatus     @default(ACTIVE)
  opening_balance    Decimal?
  balance_type    BalanceType?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  sub_group          SubGroup         @relation(fields: [sub_group_id], references: [id], onDelete: Cascade)
  user               User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sub_sub_sub_groups SubSubSubGroup[]

  @@index([userId, sub_group_id])
  @@map("sub_sub_groups")
}

model SubSubSubGroup {
  id                     Int                 @id @default(autoincrement())
  sub_sub_group_id       Int
  name                   String
  userId                 Int?
  status                 MasterStatus        @default(ACTIVE)
  opening_balance        Decimal?
  balance_type    BalanceType?
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt
  sub_sub_group          SubSubGroup         @relation(fields: [sub_sub_group_id], references: [id], onDelete: Cascade)
  user                   User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sub_sub_sub_sub_groups SubSubSubSubGroup[]

  @@index([userId, sub_sub_group_id])
  @@map("sub_sub_sub_groups")
}

model SubSubSubSubGroup {
  id                   Int            @id @default(autoincrement())
  sub_sub_sub_group_id Int
  name                 String
  userId               Int?
  status               MasterStatus   @default(ACTIVE)
  opening_balance      Decimal?
  balance_type    BalanceType?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt
  sub_sub_sub_group    SubSubSubGroup @relation(fields: [sub_sub_sub_group_id], references: [id], onDelete: Cascade)
  user                 User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sub_sub_sub_group_id])
  @@map("sub_sub_sub_sub_groups")
}

model Category {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  user_id    Int
  parent_id  String?      @db.Uuid
  status     MasterStatus @default(ACTIVE)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent     Category?    @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Restrict)
  children   Category[]   @relation("CategoryHierarchy")
  products   Product[]    @relation("ProductCategory")

  @@unique([name, parent_id, user_id])
  @@map("categories")
}

model Product {
  id              Int          @id @default(autoincrement())
  product_name    String
  product_code    String
  uom_id          Int
  product_type    ProductType
  category_id     String       @db.Uuid
  hsn_code        String
  tax_rate        Float
  description     String?
  hsn_description String?
  status          MasterStatus @default(ACTIVE)
  is_deleted      Boolean      @default(false)
  created_by      Int
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  category        Category     @relation("ProductCategory", fields: [category_id], references: [id])
  creator         User         @relation(fields: [created_by], references: [id])
  hsnMasterId     String?      @db.Uuid @map("hsn_master_id")
  hsnMaster       HsnMaster?   @relation(fields: [hsnMasterId], references: [id])
  uom             UnitMaster   @relation(fields: [uom_id], references: [id])

  @@unique([product_code, created_by])
  @@index([created_by, category_id, uom_id])
  @@map("products")
}

model PurchaseOrder {
  id               Int                 @id @default(autoincrement())
  poNumber         String
  supplierName     String
  address          String
  creditDays       Int
  poCreationDate   DateTime            @default(now())
  expiryDate       DateTime
  gstNumber        String?
  status           POStatus            @default(PENDING)
  taxAmount        Float               @default(0)
  userId           Int
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  totalAmount      Float               @default(0)
  grn              Grn[]
  purchaseInvoices PurchaseInvoice[]
  items            PurchaseOrderItem[]
  user             User                @relation(fields: [userId], references: [id])

  @@unique([poNumber, userId])
  @@index([userId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int           @id @default(autoincrement())
  purchaseOrderId  Int
  productCode      String
  productName      String
  hsnCode          String
  quantity         Float
  rate             Float
  uom              String
  discountPercent  Float
  discountAmount   Float
  taxPercent       Float
  taxAmount        Float
  beforeTaxAmount  Float         @default(0)
  totalAmount      Float
  printDescription String?
  productId        Int?
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId, productId])
  @@map("purchase_order_items")
}

model SalesOrder {
  id               Int              @id @default(autoincrement())
  soNumber         String
  customerName     String
  customerType     CustomerType?
  address          String
  creditDays       Int
  soCreationDate   DateTime         @default(now())
  expiryDate       DateTime
  customerPoNumber String?
  poDate           DateTime?
  poExpiryDate     DateTime?
  customerAmt      Float?
  customerAmtExclTax Float?
  customerAmtInclTax Float?
  customerPoFile   String?
  gstNumber        String?
  panNumber        String?
  status         SOStatus         @default(PENDING)
  totalAmount    Float            @default(0)
  taxAmount      Float            @default(0)
  grandTotal     Float            @default(0)
  userId         Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  salesChallans  SalesChallan[]
  salesInvoices  SalesInvoice[]
  items          SalesOrderItem[]
  user           User             @relation(fields: [userId], references: [id])

  @@unique([soNumber, userId])
  @@index([userId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id               Int        @id @default(autoincrement())
  salesOrderId     Int
  productCode      String
  productName      String
  hsnCode          String
  quantity         Float
  rate             Float
  uom              String
  discountPercent  Float
  discountAmount   Float
  taxPercent       Float
  taxAmount        Float
  totalAmount      Float
  beforeTaxAmount  Float      @default(0)
  printDescription String?
  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@map("sales_order_items")
}

model PurchaseInvoice {
  id                    Int                      @id @default(autoincrement())
  invoiceNumber         String
  supplierInvoiceNumber String
  supplierInvoiceDate   DateTime
  invoiceDate           DateTime                 @default(now())
  bookingDate           DateTime                 @default(now())
  supplierName          String
  address               String
  poNumber              String?
  challanNumber         String?
  creditDays            Int
  status                PIStatus                 @default(GENERATED)
  uploadedFilePath      String?
  totalQuantity         Float                    @default(0)
  cgstAmount            Float                    @default(0)
  sgstAmount            Float                    @default(0)
  grandTotal            Float                    @default(0)
  cumulativeBalance     Float                    @default(0)
  userId                Int
  poId                  Int?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  gstNumber             String?
  igstAmount            Float                    @default(0)
  isRcm                 Boolean                  @default(false)
  isInterState          Boolean                  @default(false)
  gstType               GstType                  @default(NONE)
  supplierId            Int?
  taxableAmount         Float                    @default(0)
  expenses              PurchaseInvoiceExpense[]
  items                 PurchaseInvoiceItem[]
  purchaseOrder         PurchaseOrder?           @relation(fields: [poId], references: [id])
  user                  User                     @relation(fields: [userId], references: [id])

  @@unique([invoiceNumber, userId])
  @@index([userId, supplierId, poId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                Int             @id @default(autoincrement())
  purchaseInvoiceId Int
  productCode       String
  productName       String
  quantity          Float
  rate              Float
  uom               String
  amount            Float           @default(0)
  beforeTaxAmount   Float           @default(0)
  totalPoQty        Float           @default(0)
  productId         Int?
  taxAmount         Float           @default(0)
  taxPercent        Float           @default(0)
  discountAmount    Float           @default(0)
  discountPercent   Float           @default(0)
  hsnCode           String?
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@index([purchaseInvoiceId, productId])
  @@map("purchase_invoice_items")
}

model Grn {
  id                Int            @id @default(autoincrement())
  supplierName      String
  creditDays        Int
  address           String
  gstNumber         String?
  poNumber          String?
  challanNumber     String
  grnDate           DateTime       @default(now())
  bookingDate       DateTime       @default(now())
  poId              Int?
  grandTotal        Float          @default(0)
  userId            Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  cgstAmount        Float          @default(0)
  cumulativeBalance Float          @default(0)
  sgstAmount        Float          @default(0)
  taxableAmount     Float          @default(0)
  totalQuantity     Float          @default(0)
  status            GrnStatus      @default(GENERATED)
  igstAmount        Float          @default(0)
  isInterState      Boolean        @default(false)
  isRcm             Boolean        @default(false)
  expenses          GrnExpense[]
  items             GrnItem[]
  purchaseOrder     PurchaseOrder? @relation(fields: [poId], references: [id])
  user              User           @relation(fields: [userId], references: [id])

  @@index([userId, poId])
  @@map("grns")
}

model GrnItem {
  id               Int     @id @default(autoincrement())
  grnId            Int
  productId        Int?
  productCode      String
  productName      String
  totalPoQty       Float
  receivedPoQty    Float
  receivedQty      Float
  remainingQty     Float
  rate             Float
  uom              String
  discountAmount   Float   @default(0)
  discountPercent  Float   @default(0)
  hsnCode          String?
  taxPercent       Float   @default(0)
  beforeTaxAmount  Float   @default(0)
  taxAmount        Float   @default(0)
  totalAmount      Float   @default(0)
  printDescription String?
  amount           Float   @default(0)
  grn              Grn     @relation(fields: [grnId], references: [id], onDelete: Cascade)

  @@index([grnId, productId])
  @@map("grn_items")
}

model PurchaseInvoiceExpense {
  id                Int             @id @default(autoincrement())
  purchaseInvoiceId Int
  groupName         String
  amount            Float
  taxRate           Float           @default(0)
  taxAmount         Float           @default(0)
  isGstApplicable   Boolean         @default(false)
  isPostGst         Boolean         @default(false)
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@map("purchase_invoice_expenses")
}

model GrnExpense {
  id              Int     @id @default(autoincrement())
  grnId           Int
  groupName       String
  amount          Float
  taxRate         Float   @default(0)
  taxAmount       Float   @default(0)
  isGstApplicable Boolean @default(false)
  isPostGst       Boolean @default(false)
  grn             Grn     @relation(fields: [grnId], references: [id], onDelete: Cascade)

  @@map("grn_expenses")
}

model SalesInvoice {
  id                    Int                   @id @default(autoincrement())
  invoiceNumber         String
  customerInvoiceNumber String
  customerInvoiceDate   DateTime
  invoiceDate           DateTime              @default(now())
  bookingDate           DateTime              @default(now())
  customerName          String
  address               String
  soNumber              String?
  challanNumber         String?
  creditDays            Int
  status                SalesInvoiceStatus    @default(GENERATED)
  uploadedFilePath      String?
  totalQuantity         Float                 @default(0)
  cgstAmount            Float                 @default(0)
  sgstAmount            Float                 @default(0)
  grandTotal            Float                 @default(0)
  cumulativeBalance     Float                 @default(0)
  userId                Int
  soId                  Int?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  gstNumber             String?
  igstAmount            Float                 @default(0)
  isRcm                 Boolean               @default(false)
  isInterState          Boolean               @default(false)
  gstType               GstType               @default(NONE)
  customerId            Int?
  taxableAmount         Float                 @default(0)
  expenses              SalesInvoiceExpense[]
  items                 SalesInvoiceItem[]
  salesOrder            SalesOrder?           @relation(fields: [soId], references: [id])
  user                  User                  @relation(fields: [userId], references: [id])

  @@unique([invoiceNumber, userId])
  @@index([userId, customerId, soId])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id               Int          @id @default(autoincrement())
  salesInvoiceId   Int
  productCode      String
  productName      String
  quantity         Float
  rate             Float
  uom              String
  beforeTaxAmount  Float        @default(0)
  totalSoQty       Float        @default(0)
  productId        Int
  taxAmount        Float        @default(0)
  taxPercent       Float        @default(0)
  discountAmount   Float        @default(0)
  discountPercent  Float        @default(0)
  hsnCode          String?
  printDescription String?
  totalAmount      Float        @default(0)
  salesInvoice     SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@index([salesInvoiceId, productId])
  @@map("sales_invoice_items")
}

model SalesInvoiceExpense {
  id              Int          @id @default(autoincrement())
  salesInvoiceId  Int
  groupName       String
  amount          Float
  taxRate         Float        @default(0)
  taxAmount       Float        @default(0)
  isGstApplicable Boolean      @default(false)
  isPostGst       Boolean      @default(false)
  salesInvoice    SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@map("sales_invoice_expenses")
}

model SalesChallan {
  id                Int                   @id @default(autoincrement())
  customerName      String
  creditDays        Int
  address           String
  gstNumber         String?
  soNumber          String?
  challanNumber     String
  challanDate       DateTime              @default(now())
  bookingDate       DateTime              @default(now())
  soId              Int?
  grandTotal        Float                 @default(0)
  userId            Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  cgstAmount        Float                 @default(0)
  cumulativeBalance Float                 @default(0)
  sgstAmount        Float                 @default(0)
  taxableAmount     Float                 @default(0)
  totalQuantity     Float                 @default(0)
  status            SalesChallanStatus    @default(GENERATED)
  igstAmount        Float                 @default(0)
  isInterState      Boolean               @default(false)
  isRcm             Boolean               @default(false)
  expenses          SalesChallanExpense[]
  items             SalesChallanItem[]
  salesOrder        SalesOrder?           @relation(fields: [soId], references: [id])
  user              User                  @relation(fields: [userId], references: [id])

  @@index([userId, soId])
  @@map("sales_challans")
}

model SalesChallanItem {
  id               Int          @id @default(autoincrement())
  salesChallanId   Int
  productId        Int?
  productCode      String
  productName      String
  totalSoQty       Float
  givenSoQty       Float
  challanQty       Float
  remainingQty     Float
  rate             Float
  uom              String
  discountAmount   Float        @default(0)
  discountPercent  Float        @default(0)
  hsnCode          String?
  taxPercent       Float        @default(0)
  beforeTaxAmount  Float        @default(0)
  taxAmount        Float        @default(0)
  totalAmount      Float        @default(0)
  printDescription String?
  amount           Float        @default(0)
  salesChallan     SalesChallan @relation(fields: [salesChallanId], references: [id], onDelete: Cascade)

  @@index([salesChallanId, productId])
  @@map("sales_challan_items")
}

model SalesChallanExpense {
  id              Int          @id @default(autoincrement())
  salesChallanId  Int
  groupName       String
  amount          Float
  taxRate         Float        @default(0)
  taxAmount       Float        @default(0)
  isGstApplicable Boolean      @default(false)
  isPostGst       Boolean      @default(false)
  salesChallan    SalesChallan @relation(fields: [salesChallanId], references: [id], onDelete: Cascade)

  @@map("sales_challan_expenses")
}

