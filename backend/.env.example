# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gmark_erp_db?schema=public"

# Server Configuration
PORT=3001

# JWT Configuration
JWT_SECRET="super_secret_jwt_key_change_in_prod"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="super_secret_refresh_key_change_in_prod"
JWT_REFRESH_EXPIRATION="7d"

# Swagger Documentation
SWAGGER_PATH="/api/docs"
SWAGGER_USER="admin"
SWAGGER_PASSWORD="password"

# Redis Cache & Queue (optional / falls back gracefully)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# Development OTP settings
ENABLE_DEV_OTP="true"
DEV_OTP="123456"
